    {"id": "afirm:lamarck-heranca-adquirida", "dados": {"enunciado": "Caracteres adquiridos pelo uso e desuso dos órgãos são transmitidos aos descendentes.", "tipo_evidencia": "teoria", "localizador": "Parte I, cap. 7"}},
    {"id": "afirm:weismann-barreira", "dados": {"enunciado": "A linhagem germinativa é separada do soma, de modo que modificações somáticas não são herdadas.", "tipo_evidencia": "teoria", "limitacoes": ["A epigenética transgeracional documentou exceções pontuais em alguns organismos."]}},
    {"id": "afirm:darwin-wallace-selecao", "dados": {"enunciado": "Variedades e espécies se perpetuam e divergem por um processo natural de seleção das variações favoráveis.", "tipo_evidencia": "teoria", "localizador": "p. 45-62"}},
    {"id": "afirm:darwin-descendencia-modificacao", "dados": {"enunciado": "As espécies descendem com modificação de ancestrais comuns, sendo a seleção natural o principal mecanismo de mudança.", "tipo_evidencia": "teoria", "localizador": "Cap. IV e cap. XIV (Recapitulação)", "limitacoes": ["Darwin não dispunha de um mecanismo de hereditariedade correto (adotou a pangênese)."]}},
    {"id": "afirm:mendel-segregacao", "dados": {"enunciado": "Caracteres hereditários são determinados por fatores discretos que se segregam na formação dos gametas.", "tipo_evidencia": "experimento", "localizador": "Experimentos com Pisum sativum"}},
    {"id": "afirm:oparin-evolucao-quimica", "dados": {"enunciado": "A vida surgiu por evolução química gradual de compostos orgânicos em uma Terra primitiva com atmosfera redutora.", "tipo_evidencia": "teoria"}},
    {"id": "afirm:miller-aminoacidos", "dados": {"enunciado": "Descargas elétricas em mistura de CH4, NH3, H2 e H2O produzem aminoácidos.", "tipo_evidencia": "experimento", "localizador": "Science 117:528", "limitacoes": ["A atmosfera primitiva provavelmente era menos redutora do que a mistura usada."]}},
    {"id": "afirm:johnson-reanalise", "dados": {"enunciado": "A reanálise de amostras arquivadas do aparato 'vulcânico' de Miller identificou uma diversidade de aminoácidos maior que a relatada em 1953.", "tipo_evidencia": "experimento"}},
    {"id": "afirm:watson-crick-dupla-helice", "dados": {"enunciado": "O DNA é uma dupla hélice de duas cadeias antiparalelas unidas por pares de bases específicos (A–T, G–C).", "tipo_evidencia": "modelagem", "localizador": "Nature 171:737"}},
    {"id": "afirm:franklin-forma-b", "dados": {"enunciado": "Os padrões de difração da forma B do DNA indicam uma estrutura helicoidal com grupos fosfato na parte externa.", "tipo_evidencia": "experimento", "localizador": "Nature 171:740"}},
    {"id": "afirm:woese-archaea", "dados": {"enunciado": "Os procariotos compreendem duas linhagens primárias distintas, reveladas pelo rRNA 16S: as futuras Bacteria e Archaea.", "tipo_evidencia": "experimento", "localizador": "PNAS 74:5088"}},
    {"id": "afirm:woese-tres-dominios", "dados": {"enunciado": "Os seres vivos se organizam em três domínios: Archaea, Bacteria e Eucarya.", "tipo_evidencia": "experimento", "localizador": "PNAS 87:4576"}},
    {"id": "afirm:gilbert-mundo-rna", "dados": {"enunciado": "Antes do DNA e das proteínas, houve um 'mundo de RNA' em que o RNA era tanto material genético quanto catalisador.", "tipo_evidencia": "teoria", "localizador": "Nature 319:618"}},
    {"id": "afirm:wachtershauser-metabolismo", "dados": {"enunciado": "A vida começou como metabolismo autocatalítico em superfícies de pirita, antes de qualquer molécula replicadora.", "tipo_evidencia": "teoria"}},
    {"id": "afirm:schopf-microfosseis", "dados": {"enunciado": "Estruturas filamentosas do Apex chert (~3,46 bilhões de anos) são microfósseis de organismos celulares.", "tipo_evidencia": "estudo_observacional", "localizador": "Science 260:640"}},
    {"id": "afirm:brasier-artefatos", "dados": {"enunciado": "As estruturas do Apex chert são artefatos abióticos formados em um veio hidrotermal, não microfósseis.", "tipo_evidencia": "estudo_observacional", "localizador": "Nature 416:76"}},

    {"id": "controv:replicador-ou-metabolismo", "dados": {"nome": "Origem da vida: replicador primeiro ou metabolismo primeiro?", "pergunta": "A vida começou com moléculas replicadoras (RNA) ou com redes metabólicas autocatalíticas?"}},
    {"id": "controv:microfosseis-apex-chert", "dados": {"nome": "Os microfósseis do Apex chert", "pergunta": "As estruturas de ~3,46 bilhões de anos do Apex chert são evidência de vida?"}},

